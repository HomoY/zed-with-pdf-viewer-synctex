#!/usr/bin/env bash
# Builds "Zed with PDF Viewer (SyncTeX)" on this machine and publishes it as a GitHub release.
#
# Usage: script/pdf-viewer/release [--dry-run] vX.Y.Z-pdf.N-synctex.M
#   vX.Y.Z-pdf.N-synctex.M  The release tag: the zed-with-pdf-viewer release this
#                 is based on plus a SyncTeX release number, for example
#                 v1.24.2-pdf.4-synctex.1.
#   --dry-run     Build and check everything, print the release notes, but don't
#                 tag or publish anything.
#
# Releases the pdf-viewer branch exactly as pushed to origin: runs
# script/pdf-viewer/check, builds and verifies DMGs for Apple Silicon and Intel,
# pushes the tag and creates the GitHub release with gh.
set -euo pipefail

# Parsed as one block so editing this file while it runs can't change what runs.
{
fail() {
    echo "release: $*" >&2
    exit 1
}

dry_run=false
tag=""
for argument in "$@"; do
    case "${argument}" in
        --dry-run) dry_run=true ;;
        -h | --help)
            sed -n '2,13p' "$0"
            exit 0
            ;;
        -*) fail "unknown option ${argument}" ;;
        *) tag="${argument}" ;;
    esac
done

cd "$(dirname "$0")/../.."

# origin's release tags are the published ones, so they replace stale local copies.
git fetch --quiet --force --tags origin pdf-viewer || fail "fetching pdf-viewer and tags from origin failed"
# A dry run may build work in progress; a release must be exactly what is pushed.
if [[ "${dry_run}" == false ]]; then
    [[ "$(git branch --show-current)" == pdf-viewer ]] || fail "switch to the pdf-viewer branch first"
    [[ -z "$(git status --porcelain)" ]] || fail "commit or stash your changes first"
    [[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/pdf-viewer)" ]] ||
        fail "pdf-viewer differs from origin/pdf-viewer; push or pull first"
fi

base="$(script/pdf-viewer/upstream-version)"
[[ -n "${tag}" ]] || fail "give the release tag, for example ${base}-pdf.4-synctex.1"
[[ "${tag}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-pdf\.[0-9]+-synctex\.[0-9]+$ ]] || fail "${tag} is not a tag like v1.24.2-pdf.4-synctex.1"
[[ "${tag%-pdf.*}" == "${base}" ]] || fail "${tag} doesn't match the Zed release the branch is on (${base})"
previous="$(git tag --list 'v*-synctex.*' --sort=-v:refname | grep -vxF "${tag}" | head -n 1 || true)"
if [[ "${dry_run}" == false ]]; then
    ! git rev-parse --quiet --verify "refs/tags/${tag}" >/dev/null || fail "tag ${tag} already exists"
    command -v gh >/dev/null || fail "install the GitHub CLI (gh) first"
    gh auth status >/dev/null 2>&1 || fail "sign in with gh auth login first"
fi
echo "Releasing ${tag} from $(git log -1 --format='%h %s')"

script/pdf-viewer/check

targets=(aarch64-apple-darwin x86_64-apple-darwin)
dmgs=()
for target in "${targets[@]}"; do
    PDF_VIEWER_RELEASE_TAG="${tag}" script/pdf-viewer/bundle-mac "${target}"
    dmgs+=("target/pdf-viewer/Zed-with-PDF-Viewer-SyncTeX-${tag#v}-${target%%-*}.dmg")
done

echo "==> Verifying the DMGs"
for index in "${!targets[@]}"; do
    dmg="${dmgs[${index}]}"
    architecture="${targets[${index}]%%-*}"
    [[ "${architecture}" == aarch64 ]] && architecture=arm64
    mount_point="$(mktemp -d)"
    hdiutil attach -nobrowse -readonly -quiet -mountpoint "${mount_point}" "${dmg}"
    app="${mount_point}/Zed with PDF Viewer (SyncTeX).app"
    verified=true
    codesign --verify --deep --strict "${app}" || verified=false
    [[ -f "${app}/Contents/Frameworks/libpdfium.dylib" ]] || verified=false
    [[ "$(lipo -archs "${app}/Contents/MacOS/zed")" == "${architecture}" ]] || verified=false
    [[ "$(lipo -archs "${app}/Contents/Frameworks/libpdfium.dylib")" == "${architecture}" ]] || verified=false
    hdiutil detach -quiet "${mount_point}"
    rmdir "${mount_point}"
    [[ "${verified}" == true ]] || fail "${dmg} failed verification"
    echo "${dmg}: signed, ${architecture}, Pdfium bundled"
done

notes="$(mktemp)"
{
    echo "Zed ${base#v} with a built-in PDF viewer and SyncTeX for LaTeX, based on TendonT52/zed-with-pdf-viewer."
    echo
    # Moving to a new Zed version, or reorganizing the fork's commits, rewrites them,
    # so "since the previous release" is only listed when that release is an ancestor.
    if [[ -n "${previous}" && "${previous%-pdf.*}" == "${base}" ]] &&
        git merge-base --is-ancestor "${previous}" HEAD; then
        echo "## Changes since ${previous#v}"
        echo
        git log --no-merges --format='- %s' "${previous}..HEAD"
        echo
    elif [[ -n "${previous}" && "${previous%-pdf.*}" != "${base}" ]]; then
        echo "## Changes"
        echo
        echo "- Moved to Zed ${base#v}."
        echo
    fi
    echo "## The fork's commits on top of Zed ${base#v}"
    echo
    git log --reverse --no-merges --format='- %s' "${base}..HEAD"
    echo
    echo "## Install"
    echo
    echo "Download the DMG for your Mac: \`aarch64\` for Apple Silicon, \`x86_64\` for Intel."
    echo "The app is not notarized by Apple, so macOS blocks the first launch."
    echo "Click **Done** on the warning, then click **Open Anyway** in System Settings, Privacy & Security, or run"
    echo
    echo '```'
    echo 'xattr -dr com.apple.quarantine "/Applications/Zed with PDF Viewer (SyncTeX).app"'
    echo '```'
    echo
    echo "If that prints \"Operation not permitted\", allow your terminal under Privacy & Security, App Management, and run it again."
    echo
    echo "Upstream release notes: https://github.com/zed-industries/zed/releases/tag/${base}"
} > "${notes}"

if [[ "${dry_run}" == true ]]; then
    echo "==> Release notes (dry run, nothing was tagged or published)"
    cat "${notes}"
    printf '%s\n' "${dmgs[@]}"
    rm -f "${notes}"
    exit
fi

echo "==> Publishing ${tag}"
git tag "${tag}"
git push origin "refs/tags/${tag}"
gh release create "${tag}" "${dmgs[@]}" \
    --verify-tag \
    --title "Zed with PDF Viewer (SyncTeX) ${tag#v}" \
    --notes-file "${notes}" \
    --latest
rm -f "${notes}"
exit
}
